# Production environment template for docker-compose.production.yml
# Copy to .env.production and replace placeholders with real values.
# Do not commit .env.production — it contains secrets.

# Public hostname served by Caddy (used in deploy/Caddyfile).
APP_DOMAIN=example.com

# CORS allowed origin for the browser client.
# Leave empty for same-origin deployment when the SPA and API are served from the same domain.
APP_ORIGIN=

# SQL Server connection string for the ASP.NET Core app.
# Use an external SQL Server, or start the bundled container with:
#   docker compose --env-file .env.production -f docker-compose.production.yml --profile with-sqlserver up -d --build
# When using the bundled sqlserver service, set Server=sqlserver and match MSSQL_SA_PASSWORD below.
APP_CONNECTION_STRING=Server=sqlserver;Database=Leybedik;User Id=sa;Password=ChangeMe_StrongSqlPassword1!;TrustServerCertificate=True

# JWT signing secret. Must be at least 32 characters; use a long random value in production.
APP_JWT_SECRET=ChangeMe_Use_A_Long_Random_Secret_At_Least_32_Chars

APP_JWT_ISSUER=LeybedikInfoKiosk
APP_JWT_AUDIENCE=LeybedikInfoKioskClient
APP_JWT_EXPIRY_MINUTES=120

# MinIO credentials (internal object storage; not exposed publicly by default).
MINIO_ROOT_USER=leybedik-minio-user
MINIO_ROOT_PASSWORD=ChangeMe_StrongMinioPassword1!
MINIO_BUCKET=leybedik-materials
MINIO_REGION=us-east-1

# SQL Server container settings (only used with --profile with-sqlserver).
# MSSQL_SA_PASSWORD must meet SQL Server complexity requirements.
MSSQL_SA_PASSWORD=ChangeMe_StrongSqlPassword1!
MSSQL_PID=Express
